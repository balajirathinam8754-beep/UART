class uart_scoreboard extends uvm_scoreboard;

    `uvm_component_utils(uart_scoreboard)

    uvm_analysis_imp #(uart_sequence_item, uart_scoreboard)
        analysis_export;

    bit [7:0] expected_data;

    function new(
        string name = "uart_scoreboard",
        uvm_component parent = null
    );

        super.new(name, parent);

        analysis_export =
            new("analysis_export", this);

    endfunction

    function void write(uart_sequence_item item);

        if (item.rx_data == expected_data) begin

            `uvm_info(
                "UART_SCB",
                $sformatf(
                    "[PASS] TX=0x%02h RX=0x%02h",
                    expected_data,
                    item.rx_data
                ),
                UVM_MEDIUM
            );

        end
        else begin

            `uvm_error(
                "UART_SCB",
                $sformatf(
                    "[FAIL] Expected=0x%02h Received=0x%02h",
                    expected_data,
                    item.rx_data
                )
            );

        end

    endfunction

endclass
