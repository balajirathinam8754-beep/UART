module uart_rx #(parameter CLKS_PER_BIT = 217)(
input  wire        clk,
input  wire        rst,
input  wire        rx,          
output reg  [7:0]  rx_data,     
output reg         rx_done       
);

localparam IDLE  = 3'd0,
START = 3'd1,
DATA  = 3'd2,
STOP  = 3'd3,
DONE  = 3'd4;

reg [2:0] state;
reg [7:0] clk_count;
reg [2:0] bit_index;
reg [7:0] data_reg;
always @(posedge clk or posedge rst) begin
if (rst) begin
state     <= IDLE;
clk_count <= 0;
bit_index <= 0;
rx_done   <= 1'b0;
rx_data   <= 8'd0;
end else begin
case (state)
IDLE: begin
rx_done   <= 1'b0;
clk_count <= 0;
bit_index <= 0;

if (rx == 1'b0)
state <= START;
end
START: begin
if (clk_count == (CLKS_PER_BIT/2)) begin
if (rx == 1'b0) begin
clk_count <= 0;
state <= DATA;
end else
state <= IDLE; 
end else
clk_count <= clk_count + 1;
end
DATA: begin
if (clk_count < CLKS_PER_BIT-1)
clk_count <= clk_count + 1;
else begin
clk_count <= 0;
data_reg[bit_index] <= rx;

if (bit_index < 7)
bit_index <= bit_index + 1;
else begin
bit_index <= 0;
state <= STOP;
end
end
end
STOP: begin
if (clk_count < CLKS_PER_BIT-1)
clk_count <= clk_count + 1;
else begin
rx_data <= data_reg;
rx_done <= 1'b1;
clk_count <= 0;
state <= DONE;
end
end
DONE: begin
rx_done <= 1'b0;
state <= IDLE;
end

endcase
end
end

endmodule
