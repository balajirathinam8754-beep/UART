
module uart_tx #(parameter clk_per_bit = 217)(
input wire clk,rst,
input wire tx_start,
input wire [7:0]tx_data,
output reg tx,
output reg tx_busy);

reg [1:0]state;
reg [7:0]data_reg;
reg [7:0]clk_value;
reg [2:0]bit_index;
localparam IDLE = 2'd0,
START = 2'd1,
DATA = 2'd2,
STOP = 2'd3;
always @(posedge clk or posedge rst) begin
if(rst) begin
state <= IDLE;
tx <= 1'd1;
tx_busy <= 1'd0;
clk_value <= 0;
bit_index <= 0;
end else begin
case(state)
IDLE: begin
tx <= 1'd1;
tx_busy <= 1'd0;
clk_value <= 0;
bit_index <= 0;
if (tx_start) begin
data_reg <= tx_data;
tx_busy <= 1'd1;
state <= START;
end
end
START: begin
tx <= 1'd0;
if (clk_value < clk_per_bit - 1) 
clk_value <= clk_value + 1;
else begin
clk_value <= 0;
state <= DATA;
end
end
DATA: begin
tx <= data_reg[bit_index];
if (clk_value < clk_per_bit - 1)
clk_value <= clk_value + 1;
else begin
clk_value <= 0;
if (bit_index < 7)
bit_index <= bit_index + 1;
else begin
bit_index <= 0;
state <= STOP;
end
end
end
STOP: begin
tx <= 1'b1;
if (clk_value < clk_per_bit - 1)
clk_value <= clk_value + 1;
else begin
clk_value <= 0;
state <= IDLE;
end
end
endcase
end
end
endmodule
